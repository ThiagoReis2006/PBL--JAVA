<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="View.GUIController.DeletarSavesController">
    <children>
        <Label layoutX="298.0" layoutY="45.0" text="DELETAR SAVES">
            <font>
                <Font size="25.0" />
            </font>
        </Label>
        <VBox alignment="CENTER" layoutX="100.0" layoutY="120.0" prefWidth="600.0" spacing="20.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Label fx:id="lblSlot1" prefWidth="440.0" text="Slot 1" wrapText="true" />
                        <Button fx:id="btnSlot1" mnemonicParsing="false" onAction="#acaoDeletarSlot1" prefWidth="120.0" text="Deletar" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Label fx:id="lblSlot2" prefWidth="440.0" text="Slot 2" wrapText="true" />
                        <Button fx:id="btnSlot2" mnemonicParsing="false" onAction="#acaoDeletarSlot2" prefWidth="120.0" text="Deletar" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Label fx:id="lblSlot3" prefWidth="440.0" text="Slot 3" wrapText="true" />
                        <Button fx:id="btnSlot3" mnemonicParsing="false" onAction="#acaoDeletarSlot3" prefWidth="120.0" text="Deletar" />
                    </children>
                </HBox>
                <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#acaoVoltarMenu" prefWidth="160.0" text="Voltar ao Menu" />
            </children>
        </VBox>
    </children>
</AnchorPane>