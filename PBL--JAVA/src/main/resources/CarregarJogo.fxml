<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="View.GUIController.CarregarJogoController">
    <children>
        <Label alignment="CENTER" layoutX="0.0" layoutY="45.0" prefWidth="800.0" styleClass="titulo" text="CARREGAR JOGO" />
        <VBox alignment="CENTER" layoutX="100.0" layoutY="120.0" prefWidth="600.0" spacing="20.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="painel">
                    <children>
                        <Label fx:id="lblSlot1" prefWidth="440.0" text="Slot 1" wrapText="true" />
                        <Button fx:id="btnSlot1" mnemonicParsing="false" onAction="#acaoCarregarSlot1" prefWidth="120.0" styleClass="botao-secundario" text="Carregar" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="painel">
                    <children>
                        <Label fx:id="lblSlot2" prefWidth="440.0" text="Slot 2" wrapText="true" />
                        <Button fx:id="btnSlot2" mnemonicParsing="false" onAction="#acaoCarregarSlot2" prefWidth="120.0" styleClass="botao-secundario" text="Carregar" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="painel">
                    <children>
                        <Label fx:id="lblSlot3" prefWidth="440.0" text="Slot 3" wrapText="true" />
                        <Button fx:id="btnSlot3" mnemonicParsing="false" onAction="#acaoCarregarSlot3" prefWidth="120.0" styleClass="botao-secundario" text="Carregar" />
                    </children>
                </HBox>
                <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#acaoVoltarMenu" prefWidth="160.0" text="Voltar ao Menu" />
            </children>
        </VBox>
    </children>
</AnchorPane>